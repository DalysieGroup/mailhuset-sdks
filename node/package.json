{
  "name": "mailhuset",
  "version": "0.2.0",
  "description": "Official Node client for the Mailhuset transactional email API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["email", "transactional", "mailhuset", "api", "smtp"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DalysieGroup/mailhuset-sdks.git",
    "directory": "node"
  },
  "homepage": "https://mailhuset.com",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "devDependencies": { "typescript": "^5.6.0" }
}
